{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "mcpSpecVersion": "2026-03-26",
  "harness": "securebase-engineer-agent",
  "repository": "cedrickbyrd/securebase-app",
  "serverName": "securebase-mcp",
  "deterministicExecutionOrder": [
    "evaluate_tf_plan",
    "verify_worm_vault",
    "synthesize_remediation_pr"
  ],
  "tools": [
    {
      "name": "evaluate_tf_plan",
      "tier": "TIER_1_READ_ONLY",
      "description": "Evaluates pre-flight terraform show -json plans or AWS Security Hub ASFF findings against modular OPA Rego v1 packs (FFIEC AIO, HIPAA 164.312, NIST 800-53) in strict mode.",
      "dependsOn": [],
      "mutatesState": false,
      "requiresHumanApproval": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceType", "payload", "frameworks"],
        "properties": {
          "sourceType": {
            "type": "string",
            "enum": ["terraform_plan_json", "aws_security_hub"]
          },
          "repository": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$"
          },
          "frameworks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["FFIEC_AIO", "HIPAA_164_312", "NIST_800_53"]
            }
          },
          "strictMode": {
            "type": "boolean"
          },
          "payload": {
            "type": "object"
          }
        }
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "tier",
          "evaluatedAtUtc",
          "planSha256",
          "compliant",
          "violationCount",
          "violationsByFramework",
          "nextAllowedTool"
        ],
        "properties": {
          "runId": { "type": "string", "pattern": "^run-[a-z0-9-]+$" },
          "tier": { "type": "string", "enum": ["TIER_1_READ_ONLY"] },
          "evaluatedAtUtc": { "type": "string" },
          "planSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "compliant": { "type": "boolean" },
          "violationCount": { "type": "integer", "minimum": 0 },
          "violationsByFramework": { "type": "object" },
          "nextAllowedTool": {
            "type": "string",
            "enum": ["verify_worm_vault"]
          }
        }
      }
    },
    {
      "name": "verify_worm_vault",
      "tier": "TIER_1_READ_ONLY",
      "description": "Verifies S3 COMPLIANCE Object Lock immutability (2,555-day retention) and anchors the Tier 1 evaluation SHA-256 digest before Tier 2 remediation is unlocked.",
      "dependsOn": ["evaluate_tf_plan"],
      "mutatesState": false,
      "requiresHumanApproval": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "vaultUrn", "expectedPlanSha256"],
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^run-[a-z0-9-]+$"
          },
          "vaultUrn": {
            "type": "string",
            "pattern": "^(arn:aws:s3:::|gs://)[a-z0-9-]+$"
          },
          "expectedPlanSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "minimumRetentionDays": {
            "type": "integer",
            "minimum": 2555
          }
        }
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "verified",
          "retentionMode",
          "retentionDays",
          "evidenceChainSha256",
          "tier2GateStatus",
          "nextAllowedTool"
        ],
        "properties": {
          "runId": { "type": "string" },
          "verified": { "type": "boolean" },
          "retentionMode": { "type": "string", "enum": ["COMPLIANCE"] },
          "retentionDays": { "type": "integer", "minimum": 2555 },
          "evidenceChainSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "tier2GateStatus": {
            "type": "string",
            "enum": ["AWAITING_HUMAN_APPROVAL", "NO_REMEDIATION_NEEDED"]
          },
          "nextAllowedTool": {
            "type": "string",
            "enum": ["synthesize_remediation_pr", "NONE"]
          }
        }
      }
    },
    {
      "name": "synthesize_remediation_pr",
      "tier": "TIER_2_GATED_MUTATION",
      "description": "Synthesizes an isolated minimal HCL patch on fix/securebase-<framework>-<resource-id> with blast-radius analysis and statutory penalty justification. Blocked unless evaluate_tf_plan, verify_worm_vault, and explicit human confirmation are present.",
      "dependsOn": ["evaluate_tf_plan", "verify_worm_vault"],
      "mutatesState": true,
      "requiresHumanApproval": true,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "targetFindingIds",
          "humanConfirmed",
          "approverEmail",
          "confirmationNote"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^run-[a-z0-9-]+$"
          },
          "targetFindingIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "humanConfirmed": {
            "type": "boolean"
          },
          "approverEmail": {
            "type": "string",
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
          },
          "confirmationNote": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prId",
          "runId",
          "branchName",
          "hclPatch",
          "blastRadius",
          "regulatoryJustification",
          "attestationSha256",
          "synthesizedAtUtc"
        ],
        "properties": {
          "prId": { "type": "string" },
          "runId": { "type": "string" },
          "branchName": {
            "type": "string",
            "pattern": "^fix/securebase-(ffiec|hipaa|nist-800-53)-[a-z0-9-]+$"
          },
          "hclPatch": { "type": "string" },
          "blastRadius": { "type": "object" },
          "regulatoryJustification": { "type": "string" },
          "attestationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "synthesizedAtUtc": { "type": "string" }
        }
      }
    }
  ]
}
